/admin/*
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://*.firebaseapp.com; img-src 'self' data:; script-src 'self' https://www.gstatic.com; style-src 'self' 'unsafe-inline'

/admin/api/*
  Cache-Control: private, no-store
  X-Content-Type-Options: nosniff
